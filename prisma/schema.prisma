// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// User Model (synced from Clerk)
// ==========================================
model User {
  id        String   @id // Clerk user ID
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks       Task[]
  habits      Habit[]
  expenses    Expense[]
  notes       Note[]
  moods       MoodEntry[]
  budgetGoals BudgetGoal[]
  accounts    Account[]
  recurringExpenses RecurringExpense[]
}

// ==========================================
// Task Model
// ==========================================
model Task {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    Priority    @default(medium)
  group       String?     // e.g. "personal", "work", "projects"
  dueDate     DateTime?
  completed   Boolean     @default(false)
  recurrence  Recurrence? // null = one-off task
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
  @@index([completed])
  @@index([group])
}

enum Priority {
  low
  medium
  high
}

enum Recurrence {
  daily
  weekdays
  weekly
  biweekly
  monthly
}

// ==========================================
// Habit Model
// ==========================================
model Habit {
  id              String    @id @default(cuid())
  userId          String
  name            String
  icon            String?
  frequency       Frequency @default(daily)
  targetDays      Int[]     @default([]) // 0-6 for days of week
  archived        Boolean   @default(false)
  reminderEnabled Boolean   @default(false)
  reminderTime    String?   // HH:MM format
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
}

enum Frequency {
  daily
  weekly
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

// ==========================================
// Expense Model
// ==========================================
model Expense {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2) // exact pesos — Float drifts when summed
  category  String
  note      String?
  date      DateTime @db.Date
  // Which wallet/bank the money left. Nullable so expenses logged before
  // accounts existed stay valid; deleting an account keeps its expenses.
  accountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([category])
  @@index([userId, date])
  @@index([userId, accountId])
}

// ==========================================
// Account Model (wallets, banks, cards)
// ==========================================
model Account {
  id     String      @id @default(cuid())
  userId String
  name   String
  kind   AccountKind @default(ewallet)
  /// Balance before any tracked expense. For a credit card, enter what you
  /// already owe as a negative number.
  startingBalance Decimal @db.Decimal(12, 2) @default(0)
  /// Marks a wallet you would rather not spend from (e.g. GCash kept for
  /// emergencies). Surfaced as a warning, never enforced.
  emergencyOnly   Boolean @default(false)
  archived        Boolean @default(false)
  sortOrder       Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
}

enum AccountKind {
  ewallet
  digital_bank
  bank
  credit_card
  cash
}

// ==========================================
// Recurring Expense Model
// ==========================================
model RecurringExpense {
  id         String     @id @default(cuid())
  userId     String
  amount     Decimal    @db.Decimal(12, 2)
  category   String
  accountId  String?
  note       String?
  recurrence Recurrence
  startDate  DateTime   @db.Date
  endDate    DateTime?  @db.Date
  /// Last date an Expense was materialised for. Null = nothing generated yet.
  lastRunOn  DateTime?  @db.Date
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, active])
}

// ==========================================
// Note Model
// ==========================================
model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  tags      String[] @default([])
  category  String?  @default("general")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pinned])
  @@index([category])
}

// ==========================================
// Budget Goal Model
// ==========================================
model BudgetGoal {
  id     String   @id @default(cuid())
  userId String
  month  DateTime @db.Date // first of month
  // "overall" = whole-month budget, otherwise an EXPENSE_CATEGORIES value.
  // Deliberately NOT nullable: Postgres treats NULLs as distinct in a unique
  // index, so a nullable column here allowed duplicate overall budgets.
  category String   @default("overall")
  amount   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, category])
  @@index([userId])
  @@index([month])
}

// ==========================================
// Mood Entry Model
// ==========================================
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  mood      Int      // 1-5 scale
  energy    Int?     // 1-5 scale (optional)
  note      String?
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // One mood entry per day per user
  @@index([userId])
  @@index([date])
}
